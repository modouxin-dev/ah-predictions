{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Asian Handicap Report",
  "type": "object",
  "required": ["date", "generated_at", "picks", "watched"],
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "odds_format": {"type": "string"},
    "odds_source_note": {"type": "string"},
    "not_covered": {"type": "string"},
    "watchlist": {"type": "array", "items": {"type": "object"}},
    "picks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["match_id", "league", "home", "away", "kickoff_utc", "pick_side", "line", "odds", "confidence", "reasons", "risks", "sources"],
        "properties": {
          "match_id": {"type": "string"},
          "league": {"type": "string"},
          "home": {"type": "string"},
          "away": {"type": "string"},
          "kickoff_utc": {"type": "string", "format": "date-time"},
          "pick_side": {"enum": ["home", "away"]},
          "pick_team": {"type": "string"},
          "line": {"type": "number", "multipleOf": 0.25},
          "line_open": {"type": ["number", "null"], "multipleOf": 0.25},
          "odds": {"type": ["number", "null"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "risks": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "array", "items": {"type": "string", "format": "uri"}, "minItems": 1},
          "bet365_movement": {
            "type": "object",
            "description": "Bet365 初盘→即时盘（5DollarFootballAPI，推荐方视角，负=让球）；可选",
            "required": ["bookmaker", "open_pick_line", "pick_line"],
            "properties": {
              "bookmaker": {"type": "string"}, "fixture_id": {"type": "integer"},
              "open_pick_line": {"type": "number"}, "pick_line": {"type": "number"},
              "open_pick_water": {"type": ["number", "null"]}, "pick_water": {"type": ["number", "null"]},
              "toward_pick": {"type": "number"}
            }
          },
          "market_consensus": {
            "type": "object",
            "description": "多家公司共识（The Odds API）；可选，旧报告无此字段",
            "required": ["source", "bookmakers", "agree", "home_line", "pick_line"],
            "properties": {
              "source": {"type": "string"},
              "bookmakers": {"type": "integer"}, "agree": {"type": "integer"},
              "home_line": {"type": "number"}, "pick_line": {"type": "number"},
              "pick_water": {"type": ["number", "null"]},
              "lines": {"type": "array", "items": {"type": "number"}},
              "pinnacle": {"type": ["object", "null"]}
            }
          }
        }
      }
    },
    "watched": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["league", "home", "away", "reason_skipped"],
        "properties": {
          "league": {"type": "string"}, "home": {"type": "string"},
          "away": {"type": "string"}, "reason_skipped": {"type": "string"}
        }
      }
    }
  }
}
